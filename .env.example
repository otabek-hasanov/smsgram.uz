# SMSGram — konfiguratsiya namunasi
#
# MUHIM: Bu loyiha .env faylini avtomatik o'qimaydi (vlucas/phpdotenv kabi
# kutubxonalar ishlatilmagan). Bu fayl faqat HUJJAT sifatida beriladi —
# quyidagi qiymatlarni qo'lda app/Config/AppConfig.php fayliga yozishingiz
# kerak. Batafsil yo'riqnoma uchun README.md ga qarang.

# ---------- Ilova ----------
APP_NAME=SMSGram
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.tld
APP_TIMEZONE=Asia/Tashkent

# ---------- MySQL (mysqli, PDO emas) ----------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=smsgram
DB_USERNAME=smsgram
DB_PASSWORD=CHANGE_ME

# ---------- Redis (Predis) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PREFIX=smsgram:

# ---------- SMS yetkazish provayderi (TextUp) ----------
# Hisobingizni https://textup.uz saytida oching va quyidagilarni to'ldiring
SMS_PROVIDER_AUTH_URI=https://api-auth.textup.uz/v1/
SMS_PROVIDER_SMS_URI=https://sms-api.textup.uz/v1/
SMS_PROVIDER_EMAIL=CHANGE_ME
SMS_PROVIDER_PASSWORD=CHANGE_ME
SMS_PROVIDER_USER_ID=CHANGE_ME

# ---------- SMS narxlari (standart qiymatlar, admin panelidan ham sozlanadi) ----------
SMS_PRICE_PER_SMS=200
SMS_TEMPLATE_PRICE=20000

# ---------- Checkout.uz to'lov agregatori ----------
# Hisobingizni https://checkout.uz saytida oching va API kalitni oling
CHECKOUT_BASE_URI=https://checkout.uz/api/v1/
CHECKOUT_API_KEY=CHANGE_ME
CHECKOUT_WEBHOOK_URL=https://your-domain.tld/webhooks/checkout
